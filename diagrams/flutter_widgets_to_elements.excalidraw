    {"type":"text","id":"s5_stateful_desc","x":1140,"y":1730,"width":340,"height":220,"text":"createState() runs once.\n\nThe State object survives\nrebuilds \u2014 setState() calls\nbuild() again on the SAME\nState instance.\n\ninitState() \u2192 build() \u21c4\n[setState \u2192 build()] \u2192\ndispose()","originalText":"createState() runs once.\n\nThe State object survives\nrebuilds \u2014 setState() calls\nbuild() again on the SAME\nState instance.\n\ninitState() \u2192 build() \u21c4\n[setState \u2192 build()] \u2192\ndispose()","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":90031,"version":1,"versionNonce":90032,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.3},
