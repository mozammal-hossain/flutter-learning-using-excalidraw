    {"type":"text","id":"s7_right_callout","x":880,"y":3112,"width":560,"height":40,"text":"No bridge, no interpreter \u2014 Dart compiles to native and\ndraws straight to the GPU via Impeller.","originalText":"No bridge, no interpreter \u2014 Dart compiles to native and\ndraws straight to the GPU via Impeller.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200042,"version":1,"versionNonce":200043,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"s7_principle","x":60,"y":3242,"width":1380,"height":26,"text":"Core principle: simple is fast \u2014 and it lets apps upgrade their renderer independently of OS updates.","originalText":"Core principle: simple is fast \u2014 and it lets apps upgrade their renderer independently of OS updates.","fontSize":16,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200044,"version":1,"versionNonce":200045,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25}
