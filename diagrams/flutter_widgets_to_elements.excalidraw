    {"type":"text","id":"s6_code_text","x":785,"y":2200,"width":630,"height":195,"text":"Widget build(BuildContext context) {\n  return LayoutBuilder(\n    builder: (context, constraints) {\n      if (constraints.maxWidth < 600) {\n        return const OneColumnLayout();\n      }\n      return const TwoColumnLayout();\n    },\n  );\n}","originalText":"Widget build(BuildContext context) {\n  return LayoutBuilder(\n    builder: (context, constraints) {\n      if (constraints.maxWidth < 600) {\n        return const OneColumnLayout();\n      }\n      return const TwoColumnLayout();\n    },\n  );\n}","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100036,"version":1,"versionNonce":100037,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.35},
